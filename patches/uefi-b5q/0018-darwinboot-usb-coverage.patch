+// Read only retained page-table RAM, never SMMU registers. Every next-table
+// pointer must stay inside the allocated/used pool before it is dereferenced.
+STATIC BOOLEAN
+UsbDmaIdentityRange (CONST B5Q_USB_DMA_DIAGNOSTICS *Diag, UINT64 Base, UINT64 Bytes)
+{
+  if (!Bytes) { return TRUE; }
+  if ((Base < B5Q_USB_DMA_BASE) || (Bytes > B5Q_USB_DMA_LIMIT - Base) ||
+      (Base >= B5Q_USB_DMA_LIMIT) || ((Base | Bytes) & 0xfff) ||
+      (Base < Diag->TableBase + Diag->TableBytes && Diag->TableBase < Base + Bytes)) { return FALSE; }
+  UINT64 End = Base + Bytes;
+  while (Base < End) {
+    UINT64 Table = Diag->TableBase;
+    BOOLEAN Leaf = FALSE;
+    for (UINTN Level = 0; Level < 4; ++Level) {
+      if ((Table & 0xfff) || Table < Diag->TableBase ||
+          Table - Diag->TableBase >= (UINT64)Diag->UsedPages * EFI_PAGE_SIZE) { return FALSE; }
+      UINTN Shift = 39 - 9 * Level;
+      UINT64 Entry = ReadUnaligned64 ((CONST UINT64 *)(UINTN)(Table + ((Base >> Shift) & 511) * 8));
+      if (!(Entry & 1)) { return FALSE; }
+      if (Level < 3 && (Entry & 3) == 3) { Table = Entry & 0x0000fffffffff000ULL; continue; }
+      if (!Level || (Level == 3 ? (Entry & 3) != 3 : (Entry & 3) != 1)) { return FALSE; }
+      UINT64 Mask = (1ULL << Shift) - 1;
+      if (((Entry & 0x0000fffffffff000ULL & ~Mask) | (Base & Mask)) != Base ||
+          ((Entry >> 2) & 7) != 2 || ((Entry >> 6) & 3) != 1 ||
+          ((Entry >> 8) & 3) != 3 || !(Entry & (1ULL << 10))) { return FALSE; }
+      UINT64 Next = (Base | Mask) + 1;
+      Base = MIN (End, Next); Leaf = TRUE; break;
+    }
+    if (!Leaf) { return FALSE; }
+  }
+  return TRUE;
+}
+
+STATIC BOOLEAN
+UsbDmaCoverage (
+  CONST B5Q_USB_DMA_DIAGNOSTICS *Diag, UINT64 Address, UINT64 WindowSize,
+  CONST UINT8 *Excluded, UINTN ExcludedCount, CONST UINT8 *Outside, UINTN OutsideCount
+  )
+{
+  if (!Diag->UsedPages || Diag->UsedPages > Diag->TableBytes / EFI_PAGE_SIZE ||
+      !WindowSize || WindowSize > MAX_UINT64 - Address) { return FALSE; }
+  UINT64 Cursor = Address, End = Address + WindowSize;
+  for (UINTN I = 0; I < ExcludedCount; ++I) {
+    UINT64 Base = DarwinRangeBase (Excluded, I), Bytes = DarwinRangeSize (Excluded, I);
+    if (Base < Cursor || Base > End || Bytes > End - Base ||
+        !UsbDmaIdentityRange (Diag, Cursor, Base - Cursor)) { return FALSE; }
+    Cursor = Base + Bytes;
+  }
+  if (!UsbDmaIdentityRange (Diag, Cursor, End - Cursor)) { return FALSE; }
+  for (UINTN I = 0; I < OutsideCount; ++I) {
+    if (!UsbDmaIdentityRange (Diag, DarwinRangeBase (Outside, I), DarwinRangeSize (Outside, I))) { return FALSE; }
+  }
+  return TRUE;
+}
