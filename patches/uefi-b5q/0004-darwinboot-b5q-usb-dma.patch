diff --git a/DarwinBootPkg/Driver/B5qUsbDma.h b/DarwinBootPkg/Driver/B5qUsbDma.h
new file mode 100644
index 0000000..b341100
--- /dev/null
+++ b/DarwinBootPkg/Driver/B5qUsbDma.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef B5Q_USB_DMA_H
+#define B5Q_USB_DMA_H
+
+#define B5Q_USB_DMA_PROTOCOL_GUID \
+  { 0x16470a49, 0x4aa3, 0x42f0, { 0x85, 0xeb, 0xca, 0x49, 0x3b, 0xb5, 0x8a, 0x08 } }
+#define B5Q_USB_DMA_PROTOCOL_REVISION 1
+#define B5Q_USB_DMA_SID 0x40
+#define B5Q_USB_DMA_BASE 0x80000000ULL
+#define B5Q_USB_DMA_LIMIT 0x1000000000ULL
+#define B5Q_USB_DMA_NOT_RUN MAX_UINT32
+
+// v27 XNU wire layout. The map result represents the firmware table builder.
+typedef struct {
+  UINT32 Version;
+  UINT32 Sid;
+  UINT64 Locate;
+  UINT32 Create;
+  UINT32 Configure;
+  UINT32 Attach;
+  UINT32 Map;
+  UINT64 OwnedBase;
+  UINT64 OwnedBytes;
+} B5Q_USB_DMA_STATE;
+
+typedef struct {
+  UINT64 PrepareStatus;
+  UINT64 TableBase;
+  UINT64 TableBytes;
+  UINT64 MappedBytes;
+  UINT64 RetentionStatus;
+  UINT32 Delete;
+  UINT32 HalRevision;
+} B5Q_USB_DMA_DIAGNOSTICS;
+
+typedef struct {
+  B5Q_USB_DMA_STATE State;
+  B5Q_USB_DMA_DIAGNOSTICS Diagnostics;
+} B5Q_USB_DMA_RESULT;
+
+typedef VOID (EFIAPI *B5Q_USB_DMA_PREPARE) (
+  IN UINT64 OwnedBase, IN UINT64 OwnedBytes, OUT B5Q_USB_DMA_RESULT *Result
+  );
+
+typedef struct {
+  UINT64 Revision;
+  B5Q_USB_DMA_PREPARE Prepare;
+} B5Q_USB_DMA_PROTOCOL;
+
+STATIC_ASSERT (sizeof (B5Q_USB_DMA_STATE) == 48, "XNU USB DMA state ABI");
+STATIC_ASSERT (OFFSET_OF (B5Q_USB_DMA_STATE, OwnedBase) == 32, "XNU USB DMA range ABI");
+STATIC_ASSERT (sizeof (B5Q_USB_DMA_DIAGNOSTICS) == 48, "USB DMA diagnostics ABI");
+
+#endif
diff --git a/DarwinBootPkg/Driver/B5qUsbDmaLoader.h b/DarwinBootPkg/Driver/B5qUsbDmaLoader.h
new file mode 100644
index 0000000..7b237b2
--- /dev/null
+++ b/DarwinBootPkg/Driver/B5qUsbDmaLoader.h
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef B5Q_USB_DMA_LOADER_H
+#define B5Q_USB_DMA_LOADER_H
+
+#include "B5qUsbDma.h"
+
+typedef struct {
+  UINTN Ready;
+  UINTN State;
+  UINTN Diagnostics;
+} B5Q_USB_DMA_ADT;
+
+STATIC BOOLEAN
+FindUsbDmaProperty (
+  CONST CHAR8 *Name, CONST UINT8 *Value, UINTN Offset, UINT32 Length, B5Q_USB_DMA_ADT *Adt
+  )
+{
+  UINTN *Property;
+  UINTN Expected;
+  if (AsciiStrCmp (Name, "b5q-usb-dma-ready") == 0) {
+    Property = &Adt->Ready;
+    Expected = sizeof (UINT32);
+  } else if (AsciiStrCmp (Name, "b5q-usb-dma-state") == 0) {
+    Property = &Adt->State;
+    Expected = sizeof (B5Q_USB_DMA_STATE);
+  } else if (AsciiStrCmp (Name, "b5q-usb-dma-diagnostics") == 0) {
+    Property = &Adt->Diagnostics;
+    Expected = sizeof (B5Q_USB_DMA_DIAGNOSTICS);
+  } else {
+    return TRUE;
+  }
+  if ((*Property != MAX_UINTN) || (Length != Expected) || !IsZeroBuffer (Value, Length)) {
+    return FALSE;
+  }
+  *Property = Offset;
+  return TRUE;
+}
+
+STATIC VOID
+GetUsbDmaResult (UINT64 Address, UINT64 WindowSize, B5Q_USB_DMA_RESULT *Result)
+{
+  EFI_GUID Guid = B5Q_USB_DMA_PROTOCOL_GUID;
+  B5Q_USB_DMA_PROTOCOL *Protocol = NULL;
+  ZeroMem (Result, sizeof (*Result));
+  Result->State = (B5Q_USB_DMA_STATE){
+    1, B5Q_USB_DMA_SID, EFI_NOT_STARTED, B5Q_USB_DMA_NOT_RUN, B5Q_USB_DMA_NOT_RUN,
+    B5Q_USB_DMA_NOT_RUN, B5Q_USB_DMA_NOT_RUN, Address, WindowSize
+  };
+  Result->Diagnostics.RetentionStatus = EFI_NOT_STARTED;
+  Result->Diagnostics.Delete = B5Q_USB_DMA_NOT_RUN;
+  EFI_STATUS Status = gBS->LocateProtocol (&Guid, NULL, (VOID **)&Protocol);
+  if (Status == EFI_SUCCESS) {
+    if ((Protocol == NULL) || (Protocol->Revision != B5Q_USB_DMA_PROTOCOL_REVISION) ||
+        (Protocol->Prepare == NULL)) {
+      Status = EFI_INCOMPATIBLE_VERSION;
+    } else {
+      Protocol->Prepare (Address, WindowSize, Result);
+      return;
+    }
+  }
+  Result->Diagnostics.PrepareStatus = Status;
+}
+
+STATIC BOOLEAN
+UsbDmaPagesRetained (
+  CONST EFI_MEMORY_DESCRIPTOR *Map, UINTN MapSize, UINTN Stride, UINT64 Base, UINT64 Bytes
+  )
+{
+  if ((Base < B5Q_USB_DMA_BASE) || (Base >= B5Q_USB_DMA_LIMIT) || (Bytes == 0) ||
+      (Bytes > B5Q_USB_DMA_LIMIT - Base) || (((Base | Bytes) & (EFI_PAGE_SIZE - 1)) != 0) ||
+      (Stride < sizeof (*Map)) || (MapSize % Stride != 0)) {
+    return FALSE;
+  }
+  for (UINTN Offset = 0; Offset < MapSize; Offset += Stride) {
+    CONST EFI_MEMORY_DESCRIPTOR *Entry = (CONST VOID *)((CONST UINT8 *)Map + Offset);
+    if ((Entry->Type == EfiReservedMemoryType) && (Base >= Entry->PhysicalStart) &&
+        (Entry->NumberOfPages <= (MAX_UINT64 - Entry->PhysicalStart) / EFI_PAGE_SIZE) &&
+        (Base + Bytes <= Entry->PhysicalStart + Entry->NumberOfPages * EFI_PAGE_SIZE)) {
+      return TRUE;
+    }
+  }
+  return FALSE;
+}
+
+STATIC VOID
+WriteUsbDmaResult (
+  UINT8 *Tree, CONST B5Q_USB_DMA_ADT *Adt, CONST B5Q_USB_DMA_RESULT *Result,
+  CONST EFI_MEMORY_DESCRIPTOR *Map, UINTN MapSize, UINTN Stride,
+  UINT64 Address, UINT64 WindowSize, BOOLEAN HasExclusions
+  )
+{
+  B5Q_USB_DMA_STATE StateValue = Result->State;
+  B5Q_USB_DMA_DIAGNOSTICS DiagValue = Result->Diagnostics;
+  B5Q_USB_DMA_STATE *State = &StateValue;
+  B5Q_USB_DMA_DIAGNOSTICS *Diag = &DiagValue;
+  UINT32 Ready = 0;
+  if ((Diag->PrepareStatus == EFI_SUCCESS) &&
+      (State->Version == 1) && (State->Sid == B5Q_USB_DMA_SID) && (State->Locate == EFI_SUCCESS) &&
+      (State->Create == 0) && (State->Configure == 0) && (State->Attach == 0) && (State->Map == 0) &&
+      (State->OwnedBase == Address) && (State->OwnedBytes == WindowSize)) {
+    BOOLEAN Retained = UsbDmaPagesRetained (Map, MapSize, Stride, Diag->TableBase, Diag->TableBytes);
+    if (Retained && !HasExclusions) {
+      Retained = (Diag->TableBase + Diag->TableBytes <= Address) || (Address + WindowSize <= Diag->TableBase);
+    }
+    Diag->RetentionStatus = Retained ? EFI_SUCCESS : EFI_COMPROMISED_DATA;
+    if (!Retained) {
+      State->Map = (UINT32)(EFI_COMPROMISED_DATA & MAX_UINT32);
+    }
+    Ready = Retained ? 1 : 0;
+  }
+  CopyMem (Tree + Adt->Ready, &Ready, sizeof (Ready));
+  CopyMem (Tree + Adt->State, State, sizeof (*State));
+  CopyMem (Tree + Adt->Diagnostics, Diag, sizeof (*Diag));
+}
+
+#endif
