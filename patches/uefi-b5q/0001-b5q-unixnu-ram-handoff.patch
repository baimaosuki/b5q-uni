diff --git a/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/B5qHandoffDxe.c b/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/B5qHandoffDxe.c
new file mode 100644
index 0000000..e46abdb
--- /dev/null
+++ b/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/B5qHandoffDxe.c
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Read-only runtime evidence. Never exports /chosen, serials, or bootargs.
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Protocol/GraphicsOutput.h>
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/FdtLib.h>
+#include <Library/HobLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+STATIC CONST EFI_GUID mEntryArgGuid = {
+  0xdaee82e6, 0x8090, 0x4e72, {0xbf, 0xb9, 0x78, 0xc1, 0x3c, 0xd4, 0xe3, 0x59}
+};
+STATIC EFI_EVENT mReadyEvent;
+
+STATIC VOID
+LogReg (CONST VOID *Fdt, INT32 Node, CONST CHAR8 *Kind)
+{
+  INT32 Length;
+  INT32 Parent = fdt_parent_offset (Fdt, Node);
+  INT32 Ac = fdt_address_cells (Fdt, Parent);
+  INT32 Sc = fdt_size_cells (Fdt, Parent);
+  CONST UINT32 *Reg = fdt_getprop (Fdt, Node, "reg", &Length);
+  if (Reg == NULL || (Ac != 1 && Ac != 2) || (Sc != 1 && Sc != 2) ||
+      Length <= 0 || Length % ((Ac + Sc) * sizeof (UINT32)) != 0) {
+    DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: %a reg unknown/invalid\n", Kind));
+    return;
+  }
+  for (INT32 At = 0; At < Length / (INT32)sizeof (UINT32); At += Ac + Sc) {
+    UINT64 Base = 0, Size = 0;
+    for (INT32 I = 0; I < Ac; I++) Base = (Base << 32) | fdt32_to_cpu (Reg[At + I]);
+    for (INT32 I = 0; I < Sc; I++) Size = (Size << 32) | fdt32_to_cpu (Reg[At + Ac + I]);
+    if (Size == 0 || Base > MAX_UINT64 - Size) {
+      DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: %a zero/overflow reg (not usable RAM)\n", Kind));
+      continue;
+    }
+    DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: %a base=0x%lx size=0x%lx\n", Kind, Base, Size));
+  }
+}
+
+STATIC VOID
+LogFdt (VOID)
+{
+  VOID *Hob = GetFirstGuidHob (&mEntryArgGuid);
+  UINT64 Address;
+  if (Hob == NULL || GET_GUID_HOB_DATA_SIZE (Hob) != sizeof (Address)) {
+    DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: incoming FDT HOB missing\n"));
+    return;
+  }
+  CopyMem (&Address, GET_GUID_HOB_DATA (Hob), sizeof (Address));
+  CONST VOID *Fdt = (CONST VOID *)(UINTN)Address;
+  if (Address == 0 || (Address & 7) != 0 || fdt_check_header (Fdt) != 0 ||
+      fdt_totalsize (Fdt) > 16 * 1024 * 1024) {
+    DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: incoming FDT invalid\n"));
+    return;
+  }
+  INT32 Node;
+  fdt_for_each_subnode (Node, Fdt, 0) {
+    INT32 Length;
+    CONST CHAR8 *Type = fdt_getprop (Fdt, Node, "device_type", &Length);
+    if (Type != NULL && Length == sizeof ("memory") &&
+        CompareMem (Type, "memory", sizeof ("memory")) == 0) LogReg (Fdt, Node, "DRAM");
+  }
+  INT32 Reserved = fdt_path_offset (Fdt, "/reserved-memory");
+  if (Reserved >= 0) {
+    fdt_for_each_subnode (Node, Fdt, Reserved) {
+      INT32 Length;
+      CONST CHAR8 *Status = fdt_getprop (Fdt, Node, "status", &Length);
+      if (Status != NULL && Length == sizeof ("disabled") &&
+          CompareMem (Status, "disabled", sizeof ("disabled")) == 0) continue;
+      LogReg (Fdt, Node, "reserved-memory");
+    }
+  }
+  INT32 Count = fdt_num_mem_rsv (Fdt);
+  for (INT32 I = 0; I < Count && I < 1024; I++) {
+    UINT64 Base, Size;
+    if (fdt_get_mem_rsv (Fdt, I, &Base, &Size) == 0)
+      DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: memreserve base=0x%lx size=0x%lx\n", Base, Size));
+  }
+}
+
+STATIC VOID EFIAPI
+LogHandoff (EFI_EVENT Event, VOID *Context)
+{
+  EFI_HANDLE *Handles = NULL;
+  UINTN Count = 0;
+  (VOID)Event;
+  (VOID)Context;
+  LogFdt ();
+  EFI_STATUS Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiGraphicsOutputProtocolGuid,
+                                              NULL, &Count, &Handles);
+  if (!EFI_ERROR (Status)) {
+    for (UINTN I = 0; I < Count; I++) {
+      EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop;
+      Status = gBS->HandleProtocol (Handles[I], &gEfiGraphicsOutputProtocolGuid, (VOID **)&Gop);
+      if (EFI_ERROR (Status) || Gop->Mode == NULL || Gop->Mode->Info == NULL) continue;
+      EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info = Gop->Mode->Info;
+      DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: GOP %ux%u pitch=%u format=%u base=0x%lx bytes=0x%lx main=%u\n",
+              Info->HorizontalResolution, Info->VerticalResolution, Info->PixelsPerScanLine,
+              Info->PixelFormat, Gop->Mode->FrameBufferBase, (UINT64)Gop->Mode->FrameBufferSize,
+              Info->HorizontalResolution == 1080 && Info->VerticalResolution == 2640));
+    }
+    FreePool (Handles);
+  }
+  UINTN Size = 0, Key, EntrySize;
+  UINT32 Version;
+  Status = gBS->GetMemoryMap (&Size, NULL, &Key, &EntrySize, &Version);
+  if (Status != EFI_BUFFER_TOO_SMALL || EntrySize == 0 || Size > MAX_UINTN - 16 * EntrySize) return;
+  Size += 16 * EntrySize;
+  EFI_MEMORY_DESCRIPTOR *Map = AllocatePool (Size);
+  if (Map == NULL) return;
+  Status = gBS->GetMemoryMap (&Size, Map, &Key, &EntrySize, &Version);
+  if (!EFI_ERROR (Status) && EntrySize >= sizeof (*Map)) {
+    for (UINTN At = 0; At + EntrySize <= Size; At += EntrySize) {
+      EFI_MEMORY_DESCRIPTOR *D = (VOID *)((UINT8 *)Map + At);
+      DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: EFI type=%u base=0x%lx pages=0x%lx attr=0x%lx\n",
+              D->Type, D->PhysicalStart, D->NumberOfPages, D->Attribute));
+    }
+  }
+  FreePool (Map);
+}
+
+EFI_STATUS EFIAPI
+B5qHandoffDxeEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
+{
+  (VOID)ImageHandle;
+  (VOID)SystemTable;
+  DEBUG ((DEBUG_ERROR, "B5Q-HANDOFF: runtime evidence armed; no controller or partition I/O\n"));
+  return gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, LogHandoff, NULL,
+                             &gEfiEventReadyToBootGuid, &mReadyEvent);
+}
