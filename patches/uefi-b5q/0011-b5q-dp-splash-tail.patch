diff --git a/Platforms/Samsung/b5qPkg/Include/B5qDpDma.h b/Platforms/Samsung/b5qPkg/Include/B5qDpDma.h
new file mode 100644
--- /dev/null
+++ b/Platforms/Samsung/b5qPkg/Include/B5qDpDma.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* b5q original DT cont_splash/earlymap contract, explicitly selected by
+ * the owner. The producer validates real GOP/SSPP occupancy; no SMMU
+ * register access, mapping change or DisplayDxe patch is involved. */
+#ifndef B5Q_DP_DMA_H
+#define B5Q_DP_DMA_H
+#define B5Q_DP_DMA_PROTOCOL_GUID {0x16d34ec5,0x82cc,0x481e,{0xa7,0x66,0x31,0x9e,0x57,0x20,0x15,0xb5}}
+#define B5Q_DP_SPLASH_BASE 0xb8000000ULL
+#define B5Q_DP_SPLASH_END  0xbab00000ULL
+#define B5Q_DP_ALIGNMENT  0x200000ULL
+#define B5Q_DP_MIN_POOL   0x1000000ULL
+typedef struct {
+ UINT32 Version,PrimaryChecked,SidMask,Reserved;
+ UINT64 FrameBufferBase,FrameBufferBytes,PrimaryEnd,PoolBase,PoolBytes,Alignment,PrepareStatus,RetentionStatus;
+} B5Q_DP_DMA_STATE;
+STATIC_ASSERT(sizeof(B5Q_DP_DMA_STATE)==80,"DP DMA handoff ABI");
+STATIC inline BOOLEAN B5qDpPool(B5Q_DP_DMA_STATE *S,UINT64 Base,UINT64 Bytes,UINT64 PrimaryEnd)
+{
+ if(!S||Base<B5Q_DP_SPLASH_BASE||Base>=B5Q_DP_SPLASH_END||!Bytes||Bytes>B5Q_DP_SPLASH_END-Base||
+    PrimaryEnd<Base+Bytes||PrimaryEnd>B5Q_DP_SPLASH_END)return FALSE;
+ UINT64 Pool=(PrimaryEnd+B5Q_DP_ALIGNMENT-1)&~(B5Q_DP_ALIGNMENT-1);
+ if(Pool>B5Q_DP_SPLASH_END||B5Q_DP_SPLASH_END-Pool<B5Q_DP_MIN_POOL)return FALSE;
+ S->Version=1;S->PrimaryChecked=1;S->SidMask=0x00021c00;S->Reserved=0;
+ S->FrameBufferBase=Base;S->FrameBufferBytes=Bytes;S->PrimaryEnd=PrimaryEnd;
+ S->PoolBase=Pool;S->PoolBytes=B5Q_DP_SPLASH_END-Pool;S->Alignment=B5Q_DP_ALIGNMENT;
+ return TRUE;
+}
+STATIC inline BOOLEAN B5qDpPoolValid(CONST B5Q_DP_DMA_STATE *S)
+{
+ B5Q_DP_DMA_STATE Expected={0};
+ return S&&S->Version==1&&S->PrimaryChecked==1&&S->SidMask==0x00021c00&&!S->Reserved&&
+  !S->PrepareStatus&&!S->RetentionStatus&&B5qDpPool(&Expected,S->FrameBufferBase,S->FrameBufferBytes,S->PrimaryEnd)&&
+  S->PoolBase==Expected.PoolBase&&S->PoolBytes==Expected.PoolBytes&&S->Alignment==B5Q_DP_ALIGNMENT;
+}
+#ifdef EFIAPI
+typedef VOID(EFIAPI *B5Q_DP_DMA_PREPARE)(B5Q_DP_DMA_STATE *);
+typedef struct {UINT64 Revision;B5Q_DP_DMA_PREPARE Prepare;} B5Q_DP_DMA_PROTOCOL;
+#endif
+#endif
diff --git a/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/DpDma.c b/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/DpDma.c
new file mode 100644
--- /dev/null
+++ b/Platforms/Samsung/b5qPkg/Drivers/B5qHandoffDxe/DpDma.c
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Protocol/GraphicsOutput.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include "../../Include/B5qDpDma.h"
+STATIC EFI_GUID mDpGuid=B5Q_DP_DMA_PROTOCOL_GUID;
+STATIC VOID EFIAPI PrepareDp(B5Q_DP_DMA_STATE *Out)
+{
+ if(!Out)return;
+ ZeroMem(Out,sizeof(*Out));Out->Version=1;Out->PrepareStatus=EFI_NOT_STARTED;Out->RetentionStatus=EFI_NOT_STARTED;
+ EFI_GRAPHICS_OUTPUT_PROTOCOL *Gop=NULL;
+ EFI_STATUS Status=gBS->LocateProtocol(&gEfiGraphicsOutputProtocolGuid,NULL,(VOID**)&Gop);
+ if(EFI_ERROR(Status)||!Gop||!Gop->Mode||!Gop->Mode->Info){Out->PrepareStatus=EFI_NOT_FOUND;return;}
+ CONST EFI_GRAPHICS_OUTPUT_MODE_INFORMATION *Info=Gop->Mode->Info;
+ UINT64 Base=Gop->Mode->FrameBufferBase,Bytes=Gop->Mode->FrameBufferSize;
+ UINT64 Visible=(UINT64)Info->PixelsPerScanLine*4*Info->VerticalResolution;
+ if(!Info->HorizontalResolution||!Info->VerticalResolution||Info->PixelsPerScanLine<Info->HorizontalResolution||
+    Info->PixelFormat==PixelBltOnly||Base<B5Q_DP_SPLASH_BASE||Base>=B5Q_DP_SPLASH_END||
+    Bytes>B5Q_DP_SPLASH_END-Base||Visible>Bytes){Out->PrepareStatus=EFI_COMPROMISED_DATA;return;}
+ UINT64 End=Base+Bytes;
+ // The accepted LegacyDisplay backend maps precisely FrameBufferSize
+ // and never carves a second allocation out of the retained GOP. Include
+ // its entire allocation (not only visible pixels) in PrimaryEnd.
+ Out->PrepareStatus=B5qDpPool(Out,Base,Bytes,End)?EFI_SUCCESS:EFI_BAD_BUFFER_SIZE;
+ DEBUG((DEBUG_ERROR,"B5Q-DPDMA: GOP=%lx+%lx primaryEnd=%lx pool=%lx+%lx align=%lx result=%r policy=stock-earlymap-tail\n",
+   Base,Bytes,End,Out->PoolBase,Out->PoolBytes,Out->Alignment,(EFI_STATUS)Out->PrepareStatus));
+}
+STATIC B5Q_DP_DMA_PROTOCOL mDp={1,PrepareDp};
+EFI_STATUS InstallB5qDpDma(EFI_HANDLE ImageHandle)
+{
+ return gBS->InstallMultipleProtocolInterfaces(&ImageHandle,&mDpGuid,&mDp,NULL);
+}
