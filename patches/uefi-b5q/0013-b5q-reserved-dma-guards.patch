diff --git a/Platforms/Samsung/b5qPkg/Include/B5qReservedMemory.h b/Platforms/Samsung/b5qPkg/Include/B5qReservedMemory.h
new file mode 100644
--- /dev/null
+++ b/Platforms/Samsung/b5qPkg/Include/B5qReservedMemory.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Original b5q reserved-memory fixed-reg union, including disabled no-map.
+// Input SHA256: 345420f6987a86bbaaa930c9b908668e172fdcfde44d57624679cd93c8cafb1f
+// No device identity, secure-memory reads, or MMIO; only integer boundaries.
+#ifndef B5Q_RESERVED_MEMORY_H
+#define B5Q_RESERVED_MEMORY_H
+STATIC CONST struct {UINT64 Base,End;} mB5qReservedRanges[]={
+  {0x80000000ULL,0x80e00000ULL},
+  {0x81a00000ULL,0x81cf5000ULL},
+  {0x81d00000ULL,0x81f20000ULL},
+  {0x82600000ULL,0x82800000ULL},
+  {0x8a800000ULL,0x9b09c000ULL},
+  {0x9b100000ULL,0xa43b4000ULL},
+  {0xa7d00000ULL,0xa8000000ULL},
+  {0xb01ff000ULL,0xb0240000ULL},
+  {0xb1000000ULL,0xb4000000ULL},
+  {0xb8000000ULL,0xbab00000ULL},
+  {0xd4d00000ULL,0xd8000000ULL},
+  {0xd8100000ULL,0xd8800000ULL},
+  {0xe6440000ULL,0xe671d000ULL},
+  {0xf3800000ULL,0xf7a00000ULL},
+  {0xff800000ULL,0xffe00000ULL},
+  {0x880100000ULL,0x880b02000ULL},
+  {0x880c00000ULL,0x88b900000ULL},
+  {0x8b9a00000ULL,0x8b9c00000ULL},
+  {0x8bba00000ULL,0x8c0000000ULL},
+};
+STATIC BOOLEAN B5qDmaRangeAllowed(UINT64 Base,UINT64 Bytes)
+{
+ if(!Bytes || (Base&4095) || (Bytes&4095) || Bytes>(~(UINT64)0)-Base)return FALSE;
+ UINT64 End=Base+Bytes;
+ for(UINTN I=0;I<sizeof(mB5qReservedRanges)/sizeof(mB5qReservedRanges[0]);++I)
+  if(Base<mB5qReservedRanges[I].End && mB5qReservedRanges[I].Base<End)return FALSE;
+ return TRUE;
+}
+#endif
