 // Like Samsung pci-msm-msi.c, map the register page through the PCIe domain.
 // Keep Device-nGnRnE (MAIR Attr0), separate from the Normal-WB DMA pool.
-STATIC BOOLEAN B5qPcieMapMsi(USB_DMA_TABLES *Tables)
+STATIC inline BOOLEAN B5qPcieMapMsi(USB_DMA_TABLES *Tables)
 {
   if(Tables->Used<3)return FALSE;
   UINT64 *L1=UsbDmaChild(Tables,&Tables->Pages[0]);
