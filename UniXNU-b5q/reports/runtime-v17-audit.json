  "fixes": [
    {
      "area": "diagnostics",
      "finding": "Standards-valid BUSY/TASK SET FULL/UNIT ATTENTION/NOT READY journal reads were treated as terminal. Slot-read caller stops writer on one failed read. Retry only these valid reads at most 3 times/50ms with 10ms pause outside lock; malformed/short/permanent responses fail immediately. Classify response under lock before shared state can change.",
      "evidence": "tests/b5q-ufs/test-log-read.py extracts actual nabuLogIo/Pause/Read and uses production UFS request/response plus status overwrite at unlock. Old source makes 1 failed attempt, new recovers on third. Exhaustion/short/permanent/malformed/transport/lock deadline/write/SYNC gates pass ASan/UBSan."
    },
    {
      "area": "storage",
      "finding": "doAsyncReadWrite formerly requested one 4KiB UFS read per block despite a 128KiB transport limit. Batch into a 128KiB per-device scratch buffer and still verify each block with vr_verify_block before copying. Descriptor short copy now reports actual verified bytes copied, instead of dropping them from completion count.",
      "evidence": "tests/b5q-ufs/test-verified-read.py extracts actual old/new dispatch, links production verified_root.c and real SHA256. 1MiB command count 256->8; 35 aligned/unaligned ranges, corrupted block/prefix, second-read failure, short23byte copy, final512byte sector, out-of-range and writes tested with ASan/UBSan. No measured device-speed claim."
    }
  ],
