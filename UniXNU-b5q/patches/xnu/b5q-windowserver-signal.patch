+#if __arm64__
+/* Called by the exiting task before corpse creation. Saved exception state,
+ * never the live ESR/FAR registers of an unrelated kernel instruction. */
+__attribute__((noinline)) static void
+b5q_windowserver_signal_context(proc_t p, int rv)
+{
+	static _Atomic unsigned captured;
+	unsigned enabled = 0;
+	int signal = WTERMSIG(rv);
+	if (p != current_proc() || strcmp(p->p_name, "WindowServer") != 0 ||
+	    (signal != SIGSEGV && signal != SIGBUS && signal != SIGILL && signal != SIGABRT) ||
+	    !PE_parse_boot_argn("b5q-ws-signal", &enabled, sizeof(enabled)) || enabled != 1) return;
+	unsigned slot = atomic_load_explicit(&captured, memory_order_relaxed);
+	do {
+		if (slot >= 8) return;
+	} while (!atomic_compare_exchange_weak_explicit(&captured, &slot, slot + 1,
+	    memory_order_relaxed, memory_order_relaxed));
+	printf("B5Q-WS-SIGNAL: capture=%u/8 pid=%d tid=%llu signal=%d namespace=%u code=0x%llx\n",
+	    slot + 1, proc_getpid(p), thread_tid(current_thread()), signal,
+	    p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
+	    p->p_exit_reason ? p->p_exit_reason->osr_code : 0);
+	arm_saved_state_t *state = get_user_regs(current_thread());
+	if (state && is_saved_state64(state)) {
+		printf("B5Q-WS-SIGNAL: saved pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx far=0x%llx esr=0x%llx\n",
+		    get_saved_state_pc(state), get_saved_state_lr(state), get_saved_state_sp(state),
+		    get_saved_state_fp(state), get_saved_state_far(state), (uint64_t)get_saved_state_esr(state));
+	}
+	uintptr_t frames[16];
+	struct backtrace_user_info info = BTUINFO_INIT;
+	unsigned count = backtrace_user(frames, 16, NULL, &info);
+	printf("B5Q-WS-SIGNAL: user frames=%u error=%d flags=0x%x\n", count, info.btui_error, info.btui_info);
+	for (unsigned i = 0; i < count; ++i)
+		printf("B5Q-WS-SIGNAL: user frame=%u pc=0x%llx\n", i, (uint64_t)frames[i]);
+	struct user64_dyld_all_image_infos images;
+	if (!copyin((user_addr_t)task_get_all_image_info_addr(current_task()), &images, sizeof(images))) {
+		printf("B5Q-WS-SIGNAL: dyld cache_base=0x%llx cache_slide=0x%llx images=%u\n",
+		    images.sharedCacheBaseAddress, images.sharedCacheSlide, images.infoArrayCount);
+	} else {
+		printf("B5Q-WS-SIGNAL: dyld image-info unavailable\n");
+	}
+	/* The kernel path is useful when an exit originates in a helper thread.
+	 * It is not a substitute for the saved user PC or original fault thread. */
+	count = backtrace(frames, 16, NULL, NULL);
+	for (unsigned i = 0; i < count; ++i)
+		printf("B5Q-WS-SIGNAL: kernel frame=%u pc=0x%llx\n", i, (uint64_t)frames[i]);
+}
+#endif
