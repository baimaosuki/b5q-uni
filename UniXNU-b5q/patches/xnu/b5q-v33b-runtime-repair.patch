+extern int b5q_launchd_policy_blob(unsigned, const char **, const unsigned char **, size_t *);
+static int
+b5q_launchd_policy_prepare(proc_t p, user_addr_t scratch)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	const char *dir = "/private/var/db/com.apple.xpc.launchd";
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(dir, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error) return error;
+	struct vnode_attr va;
+	VATTR_INIT(&va); VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_mode);
+	error = vnode_getattr(vp, &va, ctx);
+	if (!error && (vnode_vtype(vp) != VDIR || va.va_uid != 0 || (va.va_mode & 022))) error = EPERM;
+	vnode_put(vp);
+	if (error) return error;
+	/* Stale readiness from a previous boot must never launch the supplicant. */
+	static const char ready[] = "/private/var/run/b5q-wifi-ready";
+	struct unlink_args remove = {.path = scratch + 0x100}; int32_t result = 0;
+	error = copyout(ready, remove.path, sizeof(ready));
+	if (!error) error = unlink(p, &remove, &result);
+	if (error == ENOENT) error = 0;
+	if (error) return error;
+	for (unsigned i = 0; i < 2; i++) {
+		const char *name = NULL; const unsigned char *data = NULL; size_t bytes = 0;
+		if (!b5q_launchd_policy_blob(i, &name, &data, &bytes) || !data || !bytes || bytes > 16384) return EINVAL;
+		char path[160], temp[176];
+		snprintf(path, sizeof(path), "%s/%s", dir, name);
+		snprintf(temp, sizeof(temp), "%s/.b5q-%s.new", dir, name);
+		/* Reject symlinks/hardlinks/foreign owners on both final and temp. */
+		const char *paths[] = {path, temp};
+		for (unsigned n = 0; n < 2; n++) {
+			vp = NULLVP; error = vnode_lookup(paths[n], VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+			if (error == ENOENT) {error = 0; continue;}
+			if (error) return error;
+			VATTR_INIT(&va); VATTR_WANTED(&va, va_uid); VATTR_WANTED(&va, va_nlink);
+			error = vnode_getattr(vp, &va, ctx);
+			if (!error && (vnode_vtype(vp) != VREG || va.va_uid != 0 || va.va_nlink != 1)) error = EPERM;
+			vnode_put(vp); if (error) return error;
+		}
+		/* An already-current policy remains byte-for-byte untouched. */
+		vp = NULLVP; error = vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx);
+		bool same = false;
+		if (!error) {
+			VATTR_INIT(&va); VATTR_WANTED(&va, va_data_size); VATTR_WANTED(&va, va_mode); VATTR_WANTED(&va, va_gid);
+			error = vnode_getattr(vp, &va, ctx);
+			if (!error && va.va_data_size == bytes && (va.va_mode & 07777) == 0644 && va.va_gid == 0) {
+				unsigned char *check = kalloc_data(bytes, Z_WAITOK | Z_NOFAIL); int resid = 0;
+				error = vn_rdwr(UIO_READ, vp, (caddr_t)check, (int)bytes, 0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid, p);
+				same = !error && !resid && !memcmp(check, data, bytes); kfree_data(check, bytes);
+			}
+			vnode_close(vp, FREAD, ctx);
+		} else if (error == ENOENT) error = 0;
+		if (error) return error;
+		if (same) {printf("B5qLaunchd: policy=%s current=1 iconservices=enabled\n", name); continue;}
+		vp = NULLVP; error = vnode_open(temp, FWRITE | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600, 0, &vp, ctx);
+		if (error) return error;
+		int resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)data, (int)bytes, 0, UIO_SYSSPACE, IO_NOAUTH | IO_SYNC, vfs_context_ucred(ctx), &resid, p);
+		if (!error && resid) error = EIO;
+		if (!error) {
+			VATTR_INIT(&va); VATTR_SET(&va, va_uid, 0); VATTR_SET(&va, va_gid, 0); VATTR_SET(&va, va_mode, 0644);
+			/* XNU non-compound vnode_open may leave O_TRUNC unfinished. */
+			VATTR_SET(&va, va_data_size, bytes);
+			error = vnode_setattr(vp, &va, ctx);
+		}
+		if (!error) error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		int closed = vnode_close(vp, FWRITE, ctx); if (!error) error = closed;
+		if (error) return error;
+		struct rename_args move = {.from = scratch + 0x100, .to = scratch + 0x200};
+		error = copyout(temp, move.from, strlen(temp) + 1);
+		if (!error) error = copyout(path, move.to, strlen(path) + 1);
+		if (!error) error = rename(p, &move, &result);
+		printf("B5qLaunchd: policy=%s updated=%u bytes=%lu result=%d iconservices=enabled\n", name, !error, bytes, error);
+		if (error) return error;
+	}
+	return 0;
+}
