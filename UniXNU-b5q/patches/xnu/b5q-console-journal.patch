diff --git a/pexpert/arm/B5qLogCore.h b/pexpert/arm/B5qLogCore.h
new file mode 100644
index 0000000..2e5281c
--- /dev/null
+++ b/pexpert/arm/B5qLogCore.h
@@ -0,0 +1,77 @@
+/* Compiled into serial_console.c only for the explicit logging build option.
+ * A producer attempts the lock once, drops/counts on contention or reentry, and
+ * holds it for at most 256 bytes. No mutex, allocator, I/O, or console calls.
+ * This deliberately prefers measurable loss to waiting on a halted producer.
+ */
+#ifndef NABU_LOG_CORE_H
+#define NABU_LOG_CORE_H
+#include "B5qLogFormat.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct nb_log_snapshot { uint64_t end, first, lost; uint32_t length; };
+void nabu_capture_append(const char *,unsigned);
+int nabu_capture_snapshot(struct nb_log_snapshot *);
+int nabu_capture_copy(uint64_t,unsigned,uint8_t *);
+int nabu_capture_expand(uint8_t *);
+/* Optional owner-probe callbacks. Disabled builds supply no GPU dependency;
+ * the writer invokes only a registered bounded RAM-only snapshot callback. */
+extern void (*nabu_log_probe_poll)(void);
+extern void (*nabu_log_probe_process_snapshot)(uint32_t *);
+#ifdef __cplusplus
+}
+#endif
+#ifdef NABU_LOG_IMPLEMENTATION
+/* Small bootstrap storage until the official KMEM startup phase. */
+static uint8_t nabu_capture_early[65536];
+static uint8_t *nabu_capture_ring=nabu_capture_early;
+static unsigned nabu_capture_capacity=sizeof(nabu_capture_early);
+static unsigned nabu_capture_lock;
+static uint64_t nabu_capture_end, nabu_capture_lost;
+void (*nabu_log_probe_poll)(void)=0;
+void (*nabu_log_probe_process_snapshot)(uint32_t *)=0;
+static int nb_capture_try(void) {
+  unsigned expected=0;
+  return __atomic_compare_exchange_n(&nabu_capture_lock,&expected,1,0,__ATOMIC_ACQUIRE,__ATOMIC_RELAXED);
+}
+static void nb_capture_unlock(void) { __atomic_store_n(&nabu_capture_lock,0,__ATOMIC_RELEASE); }
+int nabu_capture_expand(uint8_t *buffer) {
+  if(!buffer || !nb_capture_try())return 0;
+  if(nabu_capture_capacity==NB_LOG_CAPACITY){nb_capture_unlock();return 0;}
+  uint64_t kept=nabu_capture_end<nabu_capture_capacity?nabu_capture_end:nabu_capture_capacity;
+  uint64_t first=nabu_capture_end-kept;
+  for(unsigned i=0;i<kept;++i)buffer[i]=nabu_capture_ring[(first+i)&(nabu_capture_capacity-1)];
+  /* If early boot outgrew its temporary store, report the discarded prefix.
+   * Restart stream indices so no holes/zero padding pretend to be log bytes. */
+  __atomic_fetch_add(&nabu_capture_lost,first,__ATOMIC_RELAXED);
+  nabu_capture_end=kept;nabu_capture_ring=buffer;nabu_capture_capacity=NB_LOG_CAPACITY;
+  nb_capture_unlock();return 1;
+}
+void nabu_capture_append(const char *p,unsigned n) {
+  if(!p) return;
+  while(n) {
+    unsigned chunk=n>256?256:n;
+    if(!nb_capture_try()) { __atomic_fetch_add(&nabu_capture_lost,(uint64_t)n,__ATOMIC_RELAXED); return; }
+    for(unsigned i=0;i<chunk;i++) nabu_capture_ring[(nabu_capture_end+i)&(nabu_capture_capacity-1)]=(uint8_t)p[i];
+    nabu_capture_end+=chunk;
+    nb_capture_unlock(); p+=chunk; n-=chunk;
+  }
+}
+int nabu_capture_snapshot(struct nb_log_snapshot *s) {
+  if(!nb_capture_try()) return 0;
+  if(nabu_capture_capacity!=NB_LOG_CAPACITY){nb_capture_unlock();return 0;}
+  s->end=nabu_capture_end;
+  s->length=s->end<nabu_capture_capacity?(uint32_t)s->end:nabu_capture_capacity;
+  s->first=s->end-s->length;
+  s->lost=__atomic_load_n(&nabu_capture_lost,__ATOMIC_RELAXED);
+  nb_capture_unlock(); return 1;
+}
+int nabu_capture_copy(uint64_t at,unsigned n,uint8_t *out) {
+  if(n>1024 || !nb_capture_try()) return 0;
+  uint64_t oldest=nabu_capture_end>nabu_capture_capacity?nabu_capture_end-nabu_capture_capacity:0;
+  int ok=at>=oldest && at<=nabu_capture_end && n<=nabu_capture_end-at;
+  if(ok) for(unsigned i=0;i<n;i++) out[i]=nabu_capture_ring[(at+i)&(nabu_capture_capacity-1)];
+  nb_capture_unlock(); return ok;
+}
+#endif
+#endif
diff --git a/pexpert/arm/B5qLogFormat.h b/pexpert/arm/B5qLogFormat.h
new file mode 100644
index 0000000..6be8ce8
--- /dev/null
+++ b/pexpert/arm/B5qLogFormat.h
@@ -0,0 +1,68 @@
+/* Portable on-medium contract. No allocation, transport, or platform headers. */
+#ifndef NABU_LOG_FORMAT_H
+#define NABU_LOG_FORMAT_H
+#include <stdint.h>
+#define NB_LOG_BLOCK 4096u
+#define NB_LOG_CAPACITY (16u * 1024u * 1024u)
+#define NB_LOG_SLOT_BYTES (NB_LOG_BLOCK + NB_LOG_CAPACITY)
+#define NB_LOG_FILE_BYTES (NB_LOG_BLOCK + 2u * NB_LOG_SLOT_BYTES)
+#define NB_LOG_NAME "XNU2LOG BIN"
+static inline uint32_t nb_le32(const uint8_t *p) {
+  return (uint32_t)p[0] | ((uint32_t)p[1]<<8) | ((uint32_t)p[2]<<16) | ((uint32_t)p[3]<<24);
+}
+static inline uint64_t nb_le64(const uint8_t *p) { return nb_le32(p) | ((uint64_t)nb_le32(p+4)<<32); }
+static inline void nb_put32(uint8_t *p, uint32_t n) {
+  for (unsigned i=0;i<4;i++) p[i]=(uint8_t)(n>>(8*i));
+}
+static inline void nb_put64(uint8_t *p, uint64_t n) {
+  nb_put32(p,(uint32_t)n); nb_put32(p+4,(uint32_t)(n>>32));
+}
+static inline int nb_equal(const void *a, const void *b, unsigned n) {
+  const uint8_t *x=(const uint8_t *)a,*y=(const uint8_t *)b;
+  for (unsigned i=0;i<n;i++) if(x[i]!=y[i]) return 0;
+  return 1;
+}
+static inline void nb_copy(void *a, const void *b, unsigned n) {
+  uint8_t *x=(uint8_t *)a; const uint8_t *y=(const uint8_t *)b;
+  for(unsigned i=0;i<n;i++) x[i]=y[i];
+}
+static inline void nb_zero(void *p,unsigned n) {
+  uint8_t *x=(uint8_t *)p; for(unsigned i=0;i<n;i++) x[i]=0;
+}
+static inline uint32_t nb_crc_update(uint32_t crc,const uint8_t *p,unsigned n) {
+  for(unsigned i=0;i<n;i++) { crc^=p[i]; for(unsigned b=0;b<8;b++) crc=(crc>>1)^(0xedb88320u & (0u-(crc&1u))); }
+  return crc;
+}
+static inline uint32_t nb_crc(const void *p,unsigned n) { return ~nb_crc_update(~0u,(const uint8_t *)p,n); }
+static inline uint32_t nb_header_crc(const uint8_t *p,unsigned zero_at) {
+  uint32_t crc=~0u; uint8_t zero[4]={0};
+  crc=nb_crc_update(crc,p,zero_at); crc=nb_crc_update(crc,zero,4);
+  return ~nb_crc_update(crc,p+zero_at+4,NB_LOG_BLOCK-zero_at-4);
+}
+/* Config: magic, version, header bytes, capacity, slot/file bytes, zero,
+ * token[16], logical block bytes, zero, CRC32 at 56, reserved zeros. */
+static inline int nb_config_valid(const uint8_t *p,const uint8_t *token) {
+  if(!nb_equal(p,"NABUCFG2",8) || nb_le32(p+8)!=2 || nb_le32(p+12)!=NB_LOG_BLOCK ||
+     nb_le32(p+16)!=NB_LOG_CAPACITY || nb_le32(p+20)!=NB_LOG_SLOT_BYTES ||
+     nb_le32(p+24)!=NB_LOG_FILE_BYTES || nb_le32(p+28) || nb_le32(p+48)!=NB_LOG_BLOCK ||
+     nb_le32(p+52) || nb_le32(p+56)!=nb_header_crc(p,56)) return 0;
+  if(token && !nb_equal(token,p+32,16)) return 0;
+  for(unsigned i=60;i<NB_LOG_BLOCK;i++) if(p[i]) return 0;
+  return 1;
+}
+/* Slot: magic, version, header bytes, committed=1, capacity, sequence u64,
+ * boot_id[16], committed stream end u64, lock-lost u64, first u64,
+ * length u32, payload CRC u32, header CRC u32, zero, ring-overwritten u64,
+ * allocation token[16], build identity[32], reserved zeros. */
+static inline int nb_slot_valid(const uint8_t *p,const uint8_t *token) {
+  if(!nb_equal(p,"NABULOG2",8) || nb_le32(p+8)!=2 || nb_le32(p+12)!=NB_LOG_BLOCK ||
+     nb_le32(p+16)!=1 || nb_le32(p+20)!=NB_LOG_CAPACITY || !nb_le64(p+24) ||
+     nb_le32(p+72)>NB_LOG_CAPACITY || nb_le32(p+84) ||
+     nb_le32(p+80)!=nb_header_crc(p,80) || !nb_equal(token,p+96,16)) return 0;
+  uint64_t end=nb_le64(p+48),first=nb_le64(p+64);
+  uint32_t n=nb_le32(p+72);
+  if(first>end || end-first!=n || n!=(end<NB_LOG_CAPACITY?end:NB_LOG_CAPACITY) || nb_le64(p+88)!=first) return 0;
+  for(unsigned i=144;i<NB_LOG_BLOCK;i++) if(p[i]) return 0;
+  return 1;
+}
+#endif
