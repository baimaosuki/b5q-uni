+// dyld invokes add-image callbacks for existing images and later loads.
+// Publish one immutable __TEXT interval: no allocation, loader scan or dladdr
+// on the supportsFamily hot path. System RenderBox remains loaded for life.
+static std::atomic<uintptr_t> gRenderBoxLo{0},gRenderBoxHi{0};
+static std::atomic_flag gRenderBoxClaim=ATOMIC_FLAG_INIT;
+static void renderBoxAdded(const struct mach_header *header,intptr_t slide) {
+ if(!header || header->magic!=MH_MAGIC_64 || gRenderBoxHi.load(std::memory_order_acquire))return;
+ const auto *mh=reinterpret_cast<const mach_header_64 *>(header);
+ const uint8_t *commands=reinterpret_cast<const uint8_t *>(mh+1);
+ const uint8_t *end=commands+mh->sizeofcmds,*at=commands;
+ bool renderBox=false;uint64_t vm=0,bytes=0;
+ for(uint32_t i=0;i<mh->ncmds;i++) {
+  if(size_t(end-at)<sizeof(load_command))return;
+  const auto *cmd=reinterpret_cast<const load_command *>(at);
+  if(cmd->cmdsize<sizeof(load_command) || cmd->cmdsize>size_t(end-at))return;
+  if(cmd->cmd==LC_ID_DYLIB && cmd->cmdsize>=sizeof(dylib_command)) {
+   const auto *lib=reinterpret_cast<const dylib_command *>(at);
+   const unsigned off=lib->dylib.name.offset;
+   if(off<sizeof(dylib_command) || off>=cmd->cmdsize)return;
+   const char *name=reinterpret_cast<const char *>(at+off);
+   if(!memchr(name,0,cmd->cmdsize-off))return;
+   renderBox=strstr(name,"/RenderBox.framework/")!=nullptr;
+  }
+  if(cmd->cmd==LC_SEGMENT_64 && cmd->cmdsize>=sizeof(segment_command_64)) {
+   const auto *seg=reinterpret_cast<const segment_command_64 *>(at);
+   if(!strncmp(seg->segname,"__TEXT",sizeof(seg->segname))){vm=seg->vmaddr;bytes=seg->vmsize;}
+  }
+  at+=cmd->cmdsize;
+ }
+ if(!renderBox || !bytes)return;
+ const uint64_t positive=slide>=0?uint64_t(slide):uint64_t(-(slide+1))+1;
+ if((slide>=0 && vm>UINTPTR_MAX-positive) || (slide<0 && vm<positive))return;
+ const uintptr_t lo=slide>=0?uintptr_t(vm+positive):uintptr_t(vm-positive);
+ if(!lo || bytes>UINTPTR_MAX-lo)return;
+ if(gRenderBoxClaim.test_and_set(std::memory_order_acquire))return;
+ gRenderBoxLo.store(lo,std::memory_order_relaxed);
+ gRenderBoxHi.store(lo+bytes,std::memory_order_release);
+}
