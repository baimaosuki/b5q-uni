- if(family>=1003 && family<2000) {   // MTLGPUFamilyApple3 and up
-  Dl_info caller;
-  if(dladdr(__builtin_return_address(0),&caller) && caller.dli_fname && strstr(caller.dli_fname,"/RenderBox.framework/"))return NO;
+ if(family>=1003 && family<2000) {
+  const uintptr_t hi=gRenderBoxHi.load(std::memory_order_acquire);
+  if(hi) {
+   const uintptr_t lo=gRenderBoxLo.load(std::memory_order_relaxed);
+   void *address=__builtin_return_address(0);
+#if __has_feature(ptrauth_calls)
+   address=ptrauth_strip(address,ptrauth_key_return_address);
+#endif
+   const uintptr_t pc=reinterpret_cast<uintptr_t>(address);
+   if(pc>=lo && pc<hi)return NO;
+  }
  }
  return gFamilyAnswer(self,_cmd,family);
 }
